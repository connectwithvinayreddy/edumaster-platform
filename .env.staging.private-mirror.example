# EduMaster isolated staging/private mirror template
# Copy this file to .env.staging.private-mirror on the staging host and fill the placeholders.
# Use a separate staging DB + Redis copy. Do not point this file at production student/payment/watch data.

SERVICE_NAME=edumaster-staging-mirror
COMPOSE_PROJECT_NAME=edumaster-staging-mirror
NODE_ENV=production
ENVIRONMENT_LABEL=staging-private-mirror
PORT=3000
HOST=0.0.0.0

# Public staging mirror URLs
APP_URL=https://app.203.0.113.10.nip.io
APP_DOMAIN=app.203.0.113.10.nip.io
LIVE_DOMAIN=live.203.0.113.10.nip.io
VITE_PUBLIC_APP_URL=https://app.203.0.113.10.nip.io
VITE_API_BASE_URL=https://app.203.0.113.10.nip.io/backend/api
LIVE_CLASSES_ENABLED=false
VITE_LIVE_CLASSES_ENABLED=false

# Security
JWT_SECRET=replace_with_generated_staging_jwt_secret
PRIVATE_VIDEO_TOKEN_SECRET=replace_with_generated_staging_private_video_token_secret

# Admin / worker auth
ADMIN_NAME=EduMaster-Staging-Admin
ADMIN_EMAIL=replace_with_staging_admin_email
ADMIN_PASSWORD=replace_with_staging_admin_password
REPLAY_IMPORT_ADMIN_EMAIL=replace_with_staging_replay_admin_email
REPLAY_IMPORT_ADMIN_PASSWORD=replace_with_staging_replay_admin_password

# CORS
CORS_ORIGIN=https://app.203.0.113.10.nip.io,http://localhost,capacitor://localhost,ionic://localhost

# Isolated staging database / redis
POSTGRES_URL=postgresql://postgres:replace_with_staging_postgres_password@postgres:5432/edumaster
POSTGRES_DB=edumaster
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_staging_postgres_password
REDIS_URL=redis://:replace_with_staging_redis_password@redis:6379
REDIS_PASSWORD=replace_with_staging_redis_password
FIREBASE_STATE_STORAGE=false

# Video storage / mirrored course-content references
PRIVATE_VIDEO_STORAGE_PROVIDER=s3
VIDEO_HLS_STORAGE_PROVIDER=s3
VIDEO_PROCESSING_PROVIDER=local-hls
PRIVATE_VIDEO_STORAGE_KEY_PREFIX=staging-private-mirror/app.203.0.113.10.nip.io
STAGING_ALLOW_SHARED_PROD_STORAGE=1
S3_BUCKET=replace_with_r2_bucket_name
S3_REGION=auto
S3_ACCESS_KEY_ID=replace_with_shared_or_staging_r2_access_key_id
S3_SECRET_ACCESS_KEY=replace_with_shared_or_staging_r2_secret_access_key
S3_ENDPOINT=https://replace_with_account_id.r2.cloudflarestorage.com
S3_FORCE_PATH_STYLE=false

# AI / payments
AI_PROVIDER=auto
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
PHONEPE_ENV=production
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_API_BASE_URL=
PHONEPE_AUTH_BASE_URL=
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=

# Video processing / protected playback
ENABLE_VIDEO_TRANSCODING=true
SOURCE_PLAYBACK_FALLBACK_ENABLED=true
VIDEO_DELIVERY_PROFILE=r2-private-hls
VIDEO_TARGET_RENDITIONS=240p,360p,480p,720p
VIDEO_HLS_SEGMENT_DURATION_SECONDS=4
VIDEO_TRANSCODING_JOB_TIMEOUT_MS=2700000
VIDEO_PROCESSING_STALE_AFTER_MS=1200000
VIDEO_KEEP_SOURCE_AFTER_PROCESSING=true
MAX_VIDEO_UPLOAD_MB=2048
VITE_MAX_VIDEO_UPLOAD_MB=2048
PRIVATE_VIDEO_TOKEN_TTL_SECONDS=900
PRIVATE_VIDEO_DELIVERY_URL_TTL_SECONDS=900
PRIVATE_VIDEO_HLS_SEGMENT_TOKEN_TTL_SECONDS=21600
PRIVATE_VIDEO_HLS_CACHE_WARM_BASE_URL=http://recorded-hls-cache:8080
PRIVATE_VIDEO_DRM_ENABLED=false
PRIVATE_VIDEO_REQUIRE_DRM_FOR_PAID_PLAYBACK=false
PRIVATE_VIDEO_STRICT_PLATFORM_RESTRICTION=false
VITE_ENABLE_BROWSER_CONTENT_PROTECTION=false
COURSE_DEFAULT_VALIDITY_DAYS=183
VIDEO_REPLAY_VIEW_LIMIT_ENABLED=false
VIDEO_REPLAY_MAX_VIEWS=0
VIDEO_REPLAY_RETENTION_DAYS=183

# Rate limiting / platform behavior
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
TRUST_PROXY=true
JSON_BODY_LIMIT=1mb
LOG_LEVEL=info
PLATFORM_DATA_CACHE_TTL_MS=30000
ALLOW_MEMORY_FALLBACK=false
EXPOSE_SAMPLE_CREDENTIALS=false
STAGING_KEEP_LIVE_CLASSES=false

# Managed HLS / live infra
LIVE_HLS_INTERNAL_BASE_URL=https://live.203.0.113.10.nip.io/hls
LIVE_HLS_PUBLIC_BASE_URL=https://live.203.0.113.10.nip.io/hls
LIVE_INGEST_STREAM_BASE_URL=rtmp://live.203.0.113.10.nip.io:1935/live
LIVE_INGEST_PUBLISHER_SECRET=replace_with_generated_staging_live_ingest_secret
VITE_LIVE_HLS_BASE_URL=https://live.203.0.113.10.nip.io/hls
VITE_LIVE_INGEST_RTMP_URL=rtmp://live.203.0.113.10.nip.io:1935/live

# Optional LiveKit
VITE_LIVEKIT_URL=
LIVEKIT_URL=
